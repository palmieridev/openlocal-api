APP_ENV=development
PORT=8080

PGHOST=localhost
PGPORT=5432
PGUSER=openlocal
PGPASSWORD=openlocal
PGDATABASE=openlocal
DATABASE_URL=postgres://openlocal:openlocal@localhost:5432/openlocal?sslmode=disable

# Pulled by `clerk env pull`; do not commit real values.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
# Optional. If omitted, issuer/JWKS are derived from CLERK_PUBLISHABLE_KEY.
CLERK_ISSUER_URL=
CLERK_JWKS_URL=
CLERK_AUTHORIZED_PARTIES=http://localhost:3000,http://localhost:5173,http://localhost:4321

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4321

# Per-process API limits. Use shared edge/Redis limits when running multiple replicas.
RATE_LIMIT_WINDOW=1m
GLOBAL_RATE_LIMIT_MAX=600
PUBLIC_RATE_LIMIT_MAX=120
PRIVATE_RATE_LIMIT_MAX=300
WEBHOOK_RATE_LIMIT_MAX=60

# Operational modules. Generate MODULES_TOKEN_KEY with 32 random bytes encoded
# as base64. The challenge bypass is local-test-only and production rejects it.
MODULES_TOKEN_KEY=
MODULES_ALLOW_TEST_CHALLENGE=false
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAMES=openlocal.store
APP_BASE_URL=http://localhost:4321

# Stripe Billing (direct integration; Clerk remains authentication only).
# Prices must be active, recurring monthly MXN prices matching these cent values.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ESSENTIAL_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=
STRIPE_SECOND_MODULE_PRICE_ID=
STRIPE_PORTAL_CONFIGURATION_ID=
ESSENTIAL_MONTHLY_CENTS=5900
BUSINESS_MONTHLY_CENTS=14900
SECOND_MODULE_MONTHLY_CENTS=4900

# Production Docker image runs migrations before the API starts by default.
RUN_MIGRATIONS=true
