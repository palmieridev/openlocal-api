APP_ENV=development
HTTP_ADDR=:8080

PGHOST=localhost
PGPORT=5432
PGUSER=openlocal
PGPASSWORD=openlocal
PGDATABASE=openlocal
DATABASE_URL=postgres://openlocal:openlocal@localhost:5432/openlocal?sslmode=disable

# Pulled by `clerk env pull`; do not commit real values.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional. If omitted, issuer/JWKS are derived from CLERK_PUBLISHABLE_KEY.
CLERK_ISSUER_URL=
CLERK_JWKS_URL=
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
